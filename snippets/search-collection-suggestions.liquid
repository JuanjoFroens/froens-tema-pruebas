{%- if show -%}
  <style>
    .search-cs{padding:10px 16px 0;border-bottom:1px solid rgba(0,0,0,.08);margin-bottom:4px}
    .search-cs__label{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:#999;margin-bottom:8px;display:block}
    .search-cs__pills{display:flex;flex-wrap:wrap;gap:6px;padding-bottom:10px}
    .cs-pill{display:inline-flex;align-items:center;padding:9px 14px;background:#1a1a2e;color:#fff!important;border-radius:3px;font-size:13px;font-family:inherit;text-decoration:none!important;white-space:nowrap;min-height:40px;line-height:1;transition:background .15s}
    .cs-pill:hover,.cs-pill:focus{background:#333;color:#fff!important;text-decoration:none!important}
    @media(max-width:767px){.cs-pill{font-size:14px;padding:11px 16px;min-height:44px}}
  </style>
  <div class="search-cs">
    <span class="search-cs__label">Ir a colección</span>
    <div class="search-cs__pills">{{ sg }}</div>
  </div>
{%- endif -%}
