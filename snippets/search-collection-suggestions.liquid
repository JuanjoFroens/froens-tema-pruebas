{%- comment -%}
  search-collection-suggestions.liquid
  Muestra accesos directos a colecciones según el término buscado.
  Para agregar/quitar términos, edita solo este archivo.
  Uso: {%- render 'search-collection-suggestions', terms: terms -%}
{%- endcomment -%}

{%- liquid
  assign t = terms | downcase | strip
  assign show = false
  assign sg = ''
-%}

{%- if t contains 'polera' -%}
  {%- if t contains 'manga larga' -%}
    {%- assign show = true -%}
    {%- capture sg -%}{{ sg }}<a href="/collections/poleras-manga-larga" class="cs-pill">Poleras Manga Larga →</a>{%- endcapture -%}
  {%- elsif t contains 'hombre' -%}
    {%- assign show = true -%}
    {%- capture sg -%}{{ sg }}<a href="/collections/poleras-hombre-froens" class="cs-pill">Poleras Hombre →</a>{%- endcapture -%}
  {%- elsif t contains 'mujer' -%}
    {%- assign show = true -%}
    {%- capture sg -%}{{ sg }}<a href="/collections/polera-mujer" class="cs-pill">Poleras Mujer →</a>{%- endcapture -%}
  {%- else -%}
    {%- assign show = true -%}
    {%- capture sg -%}{{ sg }}<a href="/collections/poleras-hombre-froens" class="cs-pill">Poleras Hombre →</a><a href="/collections/polera-mujer" class="cs-pill">Poleras Mujer →</a>{%- endcapture -%}
  {%- endif -%}
{%- endif -%}

