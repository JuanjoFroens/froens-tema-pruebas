<script>
(function () {
  var toggle = document.getElementById('froens-help-toggle');
  var panel = document.getElementById('froens-help-panel');
  var closeBtn = document.getElementById('froens-help-close');
  if (!toggle || !panel || !closeBtn) return;

  function setOpen(open) {
    if (open) {
      panel.classList.add('is-open');
      panel.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-label', 'Cerrar ayuda');
    } else {
      panel.classList.remove('is-open');
      panel.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-label', 'Abrir ayuda');
    }
  }

  toggle.addEventListener('click', function () {
    setOpen(!panel.classList.contains('is-open'));
  });
  closeBtn.addEventListener('click', function () { setOpen(false); });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') setOpen(false);
  });

  // Acordeón Stock por tienda
  var accTrigger = document.querySelector('.fhw-accordion-trigger');
  var accBody = document.getElementById('fhw-stock-body');
  if (accTrigger && accBody) {
    accTrigger.addEventListener('click', function () {
      var isOpen = accBody.classList.contains('is-open');
      accBody.classList.toggle('is-open', !isOpen);
      accTrigger.setAttribute('aria-expanded', String(!isOpen));
    });
  }
})();
</script>