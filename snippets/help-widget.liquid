{%- comment -%}
  Froens Help Widget
  Botón flotante con FAQ y handoff a WhatsApp.
{%- endcomment -%}

<style>
  #froens-help-toggle,
  #froens-help-panel {
    font-family: 'Archivo', -apple-system, BlinkMacSystemFont, sans-serif;
    box-sizing: border-box;
  }
  #froens-help-toggle *,
  #froens-help-panel * { box-sizing: border-box; }

  #froens-help-toggle {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #2f4937;
    border: none;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9998;
    box-shadow: 0 4px 14px rgba(0,0,0,0.15);
    transition: transform 0.2s ease;
  }
  #froens-help-toggle:hover { transform: scale(1.05); }
  #froens-help-toggle svg { width: 26px; height: 26px; }

  #froens-help-panel {
    position: fixed;
    bottom: 90px;
    right: 20px;
    width: 330px;
    max-height: 80vh;
    background: #ffffff;
    border-radius: 2px;
    border: 0.5px solid #2f4937;
    box-shadow: 0 10px 40px rgba(0,0,0,0.18);
    overflow: hidden;
    display: none;
    flex-direction: column;
    z-index: 9999;
  }
  #froens-help-panel.is-open { display: flex; }

  #froens-help-panel .fhw-header {
    background: #2f4937;
    padding: 18px 20px 14px;
    color: #ffffff;
  }
  #froens-help-panel .fhw-header-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  #froens-help-panel .fhw-title {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0;
  }
  #froens-help-panel .fhw-close {
    background: transparent;
    border: none;
    color: #ffffff;
    padding: 4px;
    cursor: pointer;
    line-height: 1;
  }
  #froens-help-panel .fhw-close svg { width: 18px; height: 18px; }
  #froens-help-panel .fhw-subtitle {
    font-size: 12px;
    color: #b5aa79;
    letter-spacing: 0.04em;
    margin: 0;
  }

  #froens-help-panel .fhw-body {
    padding: 14px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: #ffffff;
  }

  #froens-help-panel a.fhw-link {
    text-decoration: none;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 14px;
    border-radius: 2px;
    border-bottom: 0.5px solid #f7f5f4;
    transition: background 0.15s ease;
  }
  #froens-help-panel a.fhw-link:hover { background: #f7f5f4; }
  #froens-help-panel a.fhw-link .fhw-link-inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #froens-help-panel a.fhw-link svg.fhw-icon { width: 17px; height: 17px; color: #aeaeae; flex-shrink: 0; }
  #froens-help-panel a.fhw-link svg.fhw-chev { width: 14px; height: 14px; color: #aeaeae; flex-shrink: 0; }
  #froens-help-panel a.fhw-link .fhw-link-label {
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #000000;
  }

  #froens-help-panel a.fhw-featured {
    background: #f7f5f4;
    border-left: 3px solid #b5aa79;
    border-bottom: none;
    padding: 14px;
    margin-bottom: 6px;
  }
  #froens-help-panel a.fhw-featured:hover { background: #efece9; }
  #froens-help-panel a.fhw-featured svg.fhw-icon { width: 22px; height: 22px; color: #2f4937; }
  #froens-help-panel a.fhw-featured .fhw-featured-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }
  #froens-help-panel a.fhw-featured .fhw-featured-title {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #000000;
  }
  #froens-help-panel a.fhw-featured .fhw-featured-sub {
    font-size: 11px;
    color: #aeaeae;
  }
  #froens-help-panel a.fhw-featured svg.fhw-chev { color: #2f4937; }

  #froens-help-panel a.fhw-whatsapp {
    background: #2f4937;
    color: #ffffff;
    padding: 14px;
    margin-top: 10px;
    border-bottom: none;
    border-radius: 2px;
  }
  #froens-help-panel a.fhw-whatsapp:hover { background: #253b2c; }
  #froens-help-panel a.fhw-whatsapp svg.fhw-icon { width: 22px; height: 22px; color: #b5aa79; }
  #froens-help-panel a.fhw-whatsapp svg.fhw-chev { color: #ffffff; }
  #froens-help-panel a.fhw-whatsapp .fhw-whatsapp-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }
  #froens-help-panel a.fhw-whatsapp .fhw-whatsapp-title {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
  }
  #froens-help-panel a.fhw-whatsapp .fhw-whatsapp-sub {
    font-size: 11px;
    color: #b5aa79;
  }

  /* Stock por tienda — acordeón */
  #froens-help-panel .fhw-accordion {
    border-bottom: 0.5px solid #f7f5f4;
  }
  #froens-help-panel .fhw-accordion-trigger {
    width: 100%;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 14px;
    border-radius: 2px;
    transition: background 0.15s ease;
    text-align: left;
    font-family: 'Archivo', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: inherit;
  }
  #froens-help-panel .fhw-accordion-trigger:hover { background: #f7f5f4; }
  #froens-help-panel .fhw-accordion-trigger .fhw-link-inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #froens-help-panel .fhw-accordion-trigger svg.fhw-icon { width: 17px; height: 17px; color: #aeaeae; flex-shrink: 0; }
  #froens-help-panel .fhw-accordion-trigger svg.fhw-chev {
    width: 14px; height: 14px; color: #aeaeae; flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  #froens-help-panel .fhw-accordion-trigger[aria-expanded="true"] svg.fhw-chev {
    transform: rotate(90deg);
  }
  #froens-help-panel .fhw-accordion-body {
    display: none;
    padding: 8px 14px 12px 43px;
    font-size: 12px;
    font-family: 'Archivo', -apple-system, BlinkMacSystemFont, sans-serif;
    letter-spacing: 0.04em;
    color: #555555;
    line-height: 1.5;
  }
  #froens-help-panel .fhw-accordion-body.is-open { display: block; }

  @media (max-width: 480px) {
    #froens-help-panel {
      right: 10px;
      left: 10px;
      width: auto;
      bottom: 84px;
    }
    #froens-help-toggle {
      right: 14px;
      bottom: 14px;
    }
  }
</style>

