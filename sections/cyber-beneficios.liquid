{% comment %}
  SECCIÓN: Cyber Beneficios
  Archivo: sections/cyber-beneficios.liquid
  Descripción: Barra de beneficios debajo del hero
{% endcomment %}

<style>
  .cyber-benefits {
    background-color: {{ section.settings.bg_color }};
    border-top: 1px solid #e8e8e8;
    border-bottom: 1px solid #e8e8e8;
    padding: 28px 20px;
  }

  .cyber-benefits__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .cyber-benefits__item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
  }

  .cyber-benefits__icon {
    font-size: 32px;
    flex-shrink: 0;
  }

  .cyber-benefits__text strong {
    display: block;
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.text_color }};
    line-height: 1.3;
  }

  .cyber-benefits__text span {
    display: block;
    font-size: 12px;
    color: #666;
    line-height: 1.4;
    margin-top: 3px;
  }

  @media (max-width: 768px) {
    .cyber-benefits {
      padding: 32px 16px;
    }
    .cyber-benefits__inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .cyber-benefits__item {
      padding: 10px 0;
    }
  }

  @media (max-width: 480px) {
    .cyber-benefits {
      padding: 24px 16px;
    }
    .cyber-benefits__inner {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .cyber-benefits__item {
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>

<section class="cyber-benefits" id="cyber-benefits-{{ section.id }}">
  <div class="cyber-benefits__inner">
    {% for block in section.blocks %}
      <div class="cyber-benefits__item" {{ block.shopify_attributes }}>
        <div class="cyber-benefits__icon">{{ block.settings.icon }}</div>
        <div class="cyber-benefits__text">
          <strong>{{ block.settings.title }}</strong>
          <span>{{ block.settings.description }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Cyber Beneficios",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color del texto",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Ícono (emoji)",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Express 3 horas"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Descripción",
          "default": "Santiago, Viña del Mar, Concepción, Osorno y Pto. Varas"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cyber Beneficios",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "⚡",
            "title": "Express 3 horas",
            "description": "Santiago, Viña, Concepción, Osorno y Pto. Varas"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🚚",
            "title": "Envío gratis",
            "description": "En compras sobre $59.990 a todo el país"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🏪",
            "title": "Retiro en tienda",
            "description": "Compra online, retira el mismo día"
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "🔄",
            "title": "Cambios garantizados",
            "description": "30 días para cambiar si la talla no es la correcta"
          }
        }
      ]
    }
  ]
}
{% endschema %}
