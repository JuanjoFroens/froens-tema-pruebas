    { "type": "text", "id": "slide2_btn1_text", "label": "Botón 1 - Texto" },
    { "type": "url", "id": "slide2_btn1_link", "label": "Botón 1 - Link" },
    { "type": "text", "id": "slide2_btn2_text", "label": "Botón 2 - Texto" },
    { "type": "url", "id": "slide2_btn2_link", "label": "Botón 2 - Link" },
    { "type": "header", "content": "Slide 3" },
    { "type": "image_picker", "id": "slide3_image_desktop", "label": "Imagen Desktop - Slide 3" },
    { "type": "image_picker", "id": "slide3_image_mobile", "label": "Imagen Mobile - Slide 3" },
    { "type": "url", "id": "slide3_link", "label": "Link Slide 3 (opcional)" },
    { "type": "text", "id": "slide3_btn1_text", "label": "Botón 1 - Texto" },
    { "type": "url", "id": "slide3_btn1_link", "label": "Botón 1 - Link" },
    { "type": "text", "id": "slide3_btn2_text", "label": "Botón 2 - Texto" },
    { "type": "url", "id": "slide3_btn2_link", "label": "Botón 2 - Link" },
