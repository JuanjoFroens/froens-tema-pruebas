    { "type": "url", "id": "slide4_link", "label": "Link Slide 4 (opcional)" },
    { "type": "text", "id": "slide4_btn1_text", "label": "Botón 1 - Texto" },
    { "type": "url", "id": "slide4_btn1_link", "label": "Botón 1 - Link" },
    { "type": "text", "id": "slide4_btn2_text", "label": "Botón 2 - Texto" },
    { "type": "url", "id": "slide4_btn2_link", "label": "Botón 2 - Link" },
    { "type": "header", "content": "Slide 5" },
    { "type": "image_picker", "id": "slide5_image_desktop", "label": "Imagen Desktop - Slide 5" },
    { "type": "image_picker", "id": "slide5_image_mobile", "label": "Imagen Mobile - Slide 5" },
    { "type": "url", "id": "slide5_link", "label": "Link Slide 5 (opcional)" },
