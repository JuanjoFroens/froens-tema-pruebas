{% comment %}
  SECCIÓN: Home Best Sellers
  Archivo: sections/home-best-sellers.liquid
  Descripción: Slider horizontal de productos (mobile-first) con precio/oferta, para la Home.
  Nota: elegir la colección real en el editor de temas (setting "collection") — no viene
  precargada con ninguna colección por defecto para no inventar un handle que no exista.
{% endcomment %}

<style>
  .home-bs {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .home-bs__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .home-bs__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0 18px 12px;
  }

  .home-bs__title {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .home-bs__view-all {
    font-size: 11.5px;
    color: #6b675d;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .home-bs__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 0 18px 6px;
    scrollbar-width: none;
  }
  .home-bs__track::-webkit-scrollbar { display: none; }

  .home-bs__card {
    flex: none;
    width: 172px;
    text-decoration: none;
    color: inherit;
  }

  .home-bs__image-wrap {
    position: relative;
    background: #e8e5de;
    height: 215px;
    overflow: hidden;
  }

  .home-bs__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .home-bs__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: {{ section.settings.badge_color }};
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    padding: 3px 7px;
  }

  .home-bs__name {
    font-size: 12px;
    color: {{ section.settings.text_color }};
    line-height: 1.3;
    margin: 9px 0 4px;
  }

  .home-bs__prices {
    display: flex;
    gap: 7px;
    align-items: baseline;
  }

  .home-bs__price {
    font-size: 12.5px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
  }

  .home-bs__compare {
    font-size: 11px;
    color: #9a958a;
    text-decoration: line-through;
  }
</style>

<div class="home-bs" id="home-bs-{{ section.id }}">
  <div class="home-bs__inner">
    <div class="home-bs__header">
      <p class="home-bs__title">{{ section.settings.heading }}</p>
      {% if section.settings.view_all_url != blank %}
        <a href="{{ section.settings.view_all_url }}" class="home-bs__view-all">{{ section.settings.view_all_label }}</a>
      {% endif %}
    </div>

    <div class="home-bs__track">
      {% if section.settings.collection != blank %}
        {% assign coll = collections[section.settings.collection] %}
        {% for product in coll.products limit: section.settings.products_to_show %}
          <a href="{{ product.url }}" class="home-bs__card">
            <div class="home-bs__image-wrap">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 400 }}"
                  srcset="{{ product.featured_image | image_url: width: 400 }} 1x, {{ product.featured_image | image_url: width: 800 }} 2x"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy" width="400" height="{{ 400 | divided_by: product.featured_image.aspect_ratio }}">
              {% endif %}
              {% if product.compare_at_price > product.price %}
                {% assign off_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <span class="home-bs__badge">-{{ off_pct }}%</span>
              {% endif %}
            </div>
            <p class="home-bs__name">{{ product.title }}</p>
            <div class="home-bs__prices">
              <span class="home-bs__price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="home-bs__compare">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% if request.design_mode %}
          <p style="padding:0 18px;font-size:12px;color:#9a958a">
            Elige una colección real en la configuración de esta sección (ej. best sellers, novedades) para mostrar productos aquí.
          </p>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Home · Best sellers",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Best sellers"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Link 'Ver todo'"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto 'Ver todo'",
      "default": "Ver todo"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección",
      "info": "Elige la colección real que quieres mostrar como best sellers (no viene precargada)."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Cantidad de productos",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#f6f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Color badge de oferta",
      "default": "#9c2b23"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Home · Best sellers"
    }
  ]
}
{% endschema %}
