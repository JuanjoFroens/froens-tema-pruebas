{% comment %}
  SECCIÓN: Home Best Sellers
  Archivo: sections/home-best-sellers.liquid
  Descripción: Slider horizontal de productos (mobile-first) con precio/oferta, para la Home.
  Estilo alineado al Design System real de Froens (tokens/colors.css, componentes
  ProductCard/PriceDisplay/Badge del proyecto "Froens Design System" en claude.ai/design):
  texto centrado bajo la imagen, fondo bg-light detrás de la foto, badge "Oferta" verde
  (no rojo), precio en oferta también en verde, sin bordes ni sombra en la card.
{% endcomment %}

<style>
  .home-bs {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .home-bs__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .home-bs__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0 18px 14px;
  }

  .home-bs__title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: #000000;
    margin: 0;
  }

  .home-bs__view-all {
    font-size: 11.5px;
    color: #000000;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .home-bs__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    padding: 0 18px 6px;
    scrollbar-width: none;
  }
  .home-bs__track::-webkit-scrollbar { display: none; }

  .home-bs__card {
    flex: none;
    width: 172px;
    text-decoration: none;
    color: inherit;
    text-align: center;
  }

  .home-bs__image-wrap {
    position: relative;
    background: #f7f5f4;
    aspect-ratio: 0.8;
    overflow: hidden;
    margin-bottom: 12px;
  }

  .home-bs__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .home-bs__badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #2f4937;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .06em;
    line-height: 1;
    padding: 4px 8px;
    border-radius: 2px;
  }

  .home-bs__name {
    font-size: 15px;
    color: #000000;
    line-height: 1.3;
    margin: 0 0 6px;
  }

  .home-bs__prices {
    display: flex;
    gap: 8px;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
  }

  .home-bs__price {
    font-size: 16px;
    font-weight: 700;
    color: #000000;
  }
  .home-bs__price--sale { color: #2f4937; }

  .home-bs__compare {
    font-size: 13px;
    color: #aeaeae;
    text-decoration: line-through;
  }

  .home-bs__off {
    font-size: 12px;
    font-weight: 700;
    color: #2f4937;
  }
</style>

<div class="home-bs" id="home-bs-{{ section.id }}">
  <div class="home-bs__inner">
    <div class="home-bs__header">
      <p class="home-bs__title">{{ section.settings.heading }}</p>
      {% if section.settings.view_all_url != blank %}
        <a href="{{ section.settings.view_all_url }}" class="home-bs__view-all">{{ section.settings.view_all_label }}</a>
      {% endif %}
    </div>

    <div class="home-bs__track">
      {% if section.settings.collection != blank %}
        {% assign coll = collections[section.settings.collection] %}
        {% for product in coll.products limit: section.settings.products_to_show %}
          {% assign on_sale = false %}
          {% if product.compare_at_price > product.price %}
            {% assign on_sale = true %}
            {% assign off_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
          {% endif %}
          <a href="{{ product.url }}" class="home-bs__card">
            <div class="home-bs__image-wrap">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 400 }}"
                  srcset="{{ product.featured_image | image_url: width: 400 }} 1x, {{ product.featured_image | image_url: width: 800 }} 2x"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy" width="400" height="{{ 400 | divided_by: product.featured_image.aspect_ratio }}">
              {% endif %}
              {% if on_sale %}
                <span class="home-bs__badge">Oferta</span>
              {% elsif product.available == false %}
                <span class="home-bs__badge" style="background:transparent;color:#aeaeae;border:1px solid #aeaeae">Agotado</span>
              {% endif %}
            </div>
            <p class="home-bs__name">{{ product.title }}</p>
            <div class="home-bs__prices">
              <span class="home-bs__price {% if on_sale %}home-bs__price--sale{% endif %}">{{ product.price | money }}</span>
              {% if on_sale %}
                <span class="home-bs__compare">{{ product.compare_at_price | money }}</span>
                <span class="home-bs__off">-{{ off_pct }}%</span>
              {% endif %}
            </div>
          </a>
        {% endfor %}
      {% else %}
        {% if request.design_mode %}
          <p style="padding:0 18px;font-size:12px;color:#aeaeae">
            Elige una colección real en la configuración de esta sección (ej. best sellers, novedades) para mostrar productos aquí.
          </p>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Home · Best sellers",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Best sellers"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "Link 'Ver todo'"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto 'Ver todo'",
      "default": "Ver todo"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección",
      "info": "Elige la colección real que quieres mostrar como best sellers (no viene precargada)."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Cantidad de productos",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo de la sección",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacio superior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacio inferior",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Home · Best sellers"
    }
  ]
}
{% endschema %}
