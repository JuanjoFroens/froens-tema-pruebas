nk":"","button_color":"btn--white","button_style":"btn"}}},"block_order":["0506bb1e-bee2-47eb-9e4d-f256c74d1811","7f5ab90b-0370-4a13-964a-10c73c9a93c0"],"settings":{"height":"use_screen_one_half","brick_gutter":30,"borders":false,"bg_color":"","preload_image":false,"width":"wrapper","padding_top":36,"padding_bottom":36}},"section_image_rAtxxk":{"type":"section-image","settings":{"image":"shopify:\/\/shop_images\/HIST_02.webp","max_width":100,"x_align":"center","color_bg":"palette--light bg--neutral","width":"wrapper","padding_top":36,"padding_bottom":36}},"section_double_4f8irE":{"type":"section-double","blocks":{"text_BmQJ67":{"type":"text","settings":{"kicker":"TIENDAS Y EQUIPO","title":"","text":"<p>En 2016 se abre la primera tienda oficial y el equipo comienza a consolidarse. La responsabilidad y la sostenibilidad se hacen parte del adn de la marca y comenzaría a marcar la pauta de sus futuros avances.<\/p><p>Durante los años posteriores se crean y conforman las diferentes áreas de la empresa: diseño, marketing, logística y más, al mismo tempo que se seguían abriendo tiendas en Santiago y otras ciudades del país como Puerto Varas, Viña del Mar y Pucón.<\/p><p><a href=\"https:\/\/froens.cl\/pages\/casas-froens\" title=\"https:\/\/froens.cl\/pages\/casas-froens\">Ver tiendas.<\/a><\/p>","font_size":4,"text_columns":1,"align_text":"text-left","button_text":"","button_url":"","button_color":"btn--neutral","button_style":"btn-text-thick-line","text_color":"text--neutral","bg_color":""}},"image_XmajBc":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/WhatsApp_Image_2025-10-23_at_15.18.30.jpg","overlay_opacity":0,"overlay_color":"#000000","enable_overlay_text":false,"kicker":"","title":"","richtext":"","text_align":"align--middle-center","text_color":"text--white","link_text":"","link":"","button_color":"btn--white","button_style":"btn"}}},"block_order":["text_BmQJ67","image_XmajBc"],"settings":{"height":"use_screen_one_half","brick_gutter":30,"borders":fa