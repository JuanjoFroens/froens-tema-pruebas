a información puede derivar en la presentación de acciones legales, civiles y penales.<\/p>","text_size":4,"text_columns":1}},"2a5f0480-6fee-4b4f-a56a-415edde1eba6":{"type":"button","disabled":true,"settings":{"link_text_1":"Shop all","link_1":"shopify:\/\/collections\/all","button_size_1":"btn--medium","button_style_1":"btn-text-thick-line","button_color_1":"btn--neutral","link_text_2":"","link_2":"","button_size_2":"btn--medium","button_style_2":"btn-text-thick-line","button_color_2":"btn--neutral","link_text_3":"","link_3":"","button_size_3":"btn--long","button_style_3":"btn-text-thick-line","button_color_3":"btn--white"}}},"block_order":["2ed86c87-ac5a-4126-b0ca-462e65155aad","8a6fd614-d698-496b-9aa3-0601a6763d93","d21474b4-d388-42d8-91ed-fca8f13527b4","2a5f0480-6fee-4b4f-a56a-415edde1eba6"],"settings":{"align_text":"text-left","text_color":"text--neutral","bg":"palette--light bg--neutral","content_width":2000,"width":"wrapper--narrow","padding_top":36,"padding_bottom":96}}},"order":["main","f72192a5-5be1-411e-ac5b-d5f8eefe4b47","9f90f497-8696-4a0e-b176-8944166b59ff","7e27740d-7ffa-411c-98df-eabbfa192ccf","234ef239-41e6-4836-af73-5ad1b449a3d7","ec202ee9-91c8-4acd-ad8e-9615c2568513","d5fd733c-6e9d-4c97-b58a-6e8ce40da2d1"]}