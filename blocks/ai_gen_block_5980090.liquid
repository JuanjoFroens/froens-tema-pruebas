{% doc %}
  @prompt
    Tabs de navegación en el header. que pueda poner textos a la izquierda y derecha NO en el centro. Que pueda editar la tipografía y que cuando seleccione un tab se  Subrayado activo Mostrar subrayado en pestaña activa. Además que cada tab tenga la opción de incluirlo en mobile, desktop o ambos. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-tabs-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-header-tabs__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
  }

  .ai-header-tabs__group-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.tab_spacing }}px;
    align-items: center;
  }

  .ai-header-tabs__tab-{{ ai_gen_id }} {
    position: relative;
    text-decoration: none;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-size: {{ block.settings.font_size }}px;
    padding: {{ block.settings.tab_padding_vertical }}px {{ block.settings.tab_padding_horizontal }}px;
    transition: color 0.3s ease;
    {% if block.settings.text_transform == 'uppercase' %}
      text-transform: uppercase;
      letter-spacing: 0.05em;
    {% endif %}
  }

  .ai-header-tabs__tab-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
  }

  .ai-header-tabs__tab-{{ ai_gen_id }}.active {
    color: {{ block.settings.active_text_color }};
  }

  {% if block.settings.show_underline %}
    .ai-header-tabs__tab-{{ ai_gen_id }}::after {
      content: '';
      position: absolute;
      bottom: -{{ block.settings.underline_offset }}px;
      left: 0;
      width: 100%;
      height: {{ block.settings.underline_thickness }}px;
      background-color: transparent;
      transition: background-color 0.3s ease;
    }

    .ai-header-tabs__tab-{{ ai_gen_id }}.active::after {
      background-color: {{ block.settings.underline_color }};
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-header-tabs__tab-{{ ai_gen_id }}.desktop-only {
      display: none;
    }

    .ai-header-tabs__container-{{ ai_gen_id }} {
      padding: {{ block.settings.vertical_padding | times: 0.8 }}px {{ block.settings.horizontal_padding | times: 0.8 }}px;
    }

    .ai-header-tabs__group-{{ ai_gen_id }} {
      gap: {{ block.settings.tab_spacing | times: 0.7 }}px;
    }

    .ai-header-tabs__tab-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      padding: {{ block.settings.tab_padding_vertical | times: 0.8 }}px {{ block.settings.tab_padding_horizontal | times: 0.8 }}px;
    }
  }

  @media screen and (min-width: 750px) {
    .ai-header-tabs__tab-{{ ai_gen_id }}.mobile-only {
      display: none;
    }
  }
{% endstyle %}

<header-tabs-{{ ai_gen_id }} class="ai-header-tabs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-tabs__container-{{ ai_gen_id }}">
    <div class="ai-header-tabs__group-{{ ai_gen_id }} ai-header-tabs__group--left-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign tab_enabled_key = 'tab_left_' | append: i | append: '_enabled'
          assign tab_text_key = 'tab_left_' | append: i | append: '_text'
          assign tab_url_key = 'tab_left_' | append: i | append: '_url'
          assign tab_visibility_key = 'tab_left_' | append: i | append: '_visibility'

          assign tab_enabled = block.settings[tab_enabled_key]
          assign tab_text = block.settings[tab_text_key]
          assign tab_url = block.settings[tab_url_key]
          assign tab_visibility = block.settings[tab_visibility_key]
        %}

        {% if tab_enabled and tab_text != blank %}
          {% assign visibility_class = '' %}
          {% if tab_visibility == 'desktop' %}
            {% assign visibility_class = 'desktop-only' %}
          {% elsif tab_visibility == 'mobile' %}
            {% assign visibility_class = 'mobile-only' %}
          {% endif %}

          {% assign is_active = false %}
          {% if tab_url == request.path or tab_url == request.url %}
            {% assign is_active = true %}
          {% endif %}

          <a
            href="{{ tab_url }}"
            class="ai-header-tabs__tab-{{ ai_gen_id }} {{ visibility_class }} {% if is_active %}active{% endif %}"
            data-tab-id="left-{{ i }}"
          >
            {{ tab_text }}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-header-tabs__group-{{ ai_gen_id }} ai-header-tabs__group--right-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign tab_enabled_key = 'tab_right_' | append: i | append: '_enabled'
          assign tab_text_key = 'tab_right_' | append: i | append: '_text'
          assign tab_url_key = 'tab_right_' | append: i | append: '_url'
          assign tab_visibility_key = 'tab_right_' | append: i | append: '_visibility'

          assign tab_enabled = block.settings[tab_enabled_key]
          assign tab_text = block.settings[tab_text_key]
          assign tab_url = block.settings[tab_url_key]
          assign tab_visibility = block.settings[tab_visibility_key]
        %}

        {% if tab_enabled and tab_text != blank %}
          {% assign visibility_class = '' %}
          {% if tab_visibility == 'desktop' %}
            {% assign visibility_class = 'desktop-only' %}
          {% elsif tab_visibility == 'mobile' %}
            {% assign visibility_class = 'mobile-only' %}
          {% endif %}

          {% assign is_active = false %}
          {% if tab_url == request.path or tab_url == request.url %}
            {% assign is_active = true %}
          {% endif %}

          <a
            href="{{ tab_url }}"
            class="ai-header-tabs__tab-{{ ai_gen_id }} {{ visibility_class }} {% if is_active %}active{% endif %}"
            data-tab-id="right-{{ i }}"
          >
            {{ tab_text }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</header-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class HeaderTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-header-tabs__tab-{{ ai_gen_id }}');
        this.setupActiveState();
      }

      setupActiveState() {
        const currentPath = window.location.pathname;
        const currentUrl = window.location.href;

        this.tabs.forEach((tab) => {
          const tabHref = tab.getAttribute('href');
          
          if (tabHref === currentPath || tabHref === currentUrl) {
            tab.classList.add('active');
          }
        });
      }
    }

    customElements.define('header-tabs-{{ ai_gen_id }}', HeaderTabs{{ ai_gen_id }});
  })();
</script>

