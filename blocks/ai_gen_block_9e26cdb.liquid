{% doc %}
  @prompt
    Tabs de navegación en el header. que pueda poner textos a la izuquierda y derecha NO en el centro. 
    Que pueda editar la tipografia y que cuando este en una pestaña se subtaye, quiero que los link esten subrayados solo cuando se seleccionen, agregar esto: Subrayado activo
    Mostrar subrayado en pestaña activa crear dos versiones de cada tab, una para desktop y otra para mobile que puedas controlar independientemente. . 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-tabs-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-header-tabs__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    width: 100%;
  }

  .ai-header-tabs__left-{{ ai_gen_id }},
  .ai-header-tabs__right-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.tab_spacing }}px;
    align-items: center;
  }

  .ai-header-tabs__left-{{ ai_gen_id }} {
    justify-content: flex-start;
  }

  .ai-header-tabs__right-{{ ai_gen_id }} {
    justify-content: flex-end;
  }

  .ai-header-tabs__link-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-style: {{ block.settings.font_family.style }};
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: border-color 0.3s ease;
    white-space: nowrap;
  }

  .ai-header-tabs__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
  }

  .ai-header-tabs__link-{{ ai_gen_id }}.active {
    {% if block.settings.show_active_underline %}
      border-bottom-color: {{ block.settings.active_underline_color }};
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-header-tabs__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
    }

    .ai-header-tabs__left-{{ ai_gen_id }},
    .ai-header-tabs__right-{{ ai_gen_id }} {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
      gap: {{ block.settings.mobile_tab_spacing }}px;
    }

    .ai-header-tabs__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_font_size }}px;
    }
  }
{% endstyle %}

<header-tabs-{{ ai_gen_id }}
  class="ai-header-tabs-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <nav class="ai-header-tabs__container-{{ ai_gen_id }}">
    <div class="ai-header-tabs__left-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign desktop_text_key = 'desktop_left_tab_' | append: i | append: '_text'
          assign desktop_url_key = 'desktop_left_tab_' | append: i | append: '_url'
          assign desktop_text = block.settings[desktop_text_key]
          assign desktop_url = block.settings[desktop_url_key]
        %}
        {% if desktop_text != blank %}
          <a
            href="{{ desktop_url }}"
            class="ai-header-tabs__link-{{ ai_gen_id }} ai-header-tabs__link-desktop-{{ ai_gen_id }}"
            data-url="{{ desktop_url }}"
          >
            {{ desktop_text }}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-header-tabs__right-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign desktop_text_key = 'desktop_right_tab_' | append: i | append: '_text'
          assign desktop_url_key = 'desktop_right_tab_' | append: i | append: '_url'
          assign desktop_text = block.settings[desktop_text_key]
          assign desktop_url = block.settings[desktop_url_key]
        %}
        {% if desktop_text != blank %}
          <a
            href="{{ desktop_url }}"
            class="ai-header-tabs__link-{{ ai_gen_id }} ai-header-tabs__link-desktop-{{ ai_gen_id }}"
            data-url="{{ desktop_url }}"
          >
            {{ desktop_text }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </nav>
</header-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class HeaderTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.links = this.querySelectorAll('.ai-header-tabs__link-{{ ai_gen_id }}');
        this.setActiveTab();
      }

      setActiveTab() {
        const currentPath = window.location.pathname;
        
        this.links.forEach((link) => {
          const linkUrl = link.getAttribute('data-url');
          
          if (linkUrl && currentPath === linkUrl) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }
    }

    customElements.define('header-tabs-{{ ai_gen_id }}', HeaderTabs{{ ai_gen_id }});
  })();
</script>

