{% doc %}
  @prompt
    Tabs de navegación en el header. que pueda poner textos a la izuquierda y derecha NO en el centro. 
    Que pueda editar la tipografia y que cuando este en una pestaña se subtaye, quiero que los link esten subrayados solo cuando se seleccionen, agregar esto: Subrayado activo
    Mostrar subrayado en pestaña activa
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-nav-tabs-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-nav-tabs__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: {{ block.settings.gap }}px;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  }

  .ai-nav-tabs__left-{{ ai_gen_id }},
  .ai-nav-tabs__right-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    align-items: center;
  }

  .ai-nav-tabs__link-{{ ai_gen_id }} {
    font-family: {{ block.settings.font_family.family }}, {{ block.settings.font_family.fallback_families }};
    font-weight: {{ block.settings.font_family.weight }};
    font-style: {{ block.settings.font_family.style }};
    font-size: {{ block.settings.font_size }}px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    padding: {{ block.settings.link_padding_vertical }}px {{ block.settings.link_padding_horizontal }}px;
    transition: color 0.2s ease;
    position: relative;
    white-space: nowrap;
  }

  .ai-nav-tabs__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
  }

  {% if block.settings.show_active_underline %}
    .ai-nav-tabs__link-{{ ai_gen_id }}.active {
      color: {{ block.settings.text_active_color }};
      text-decoration: underline;
    }
  {% else %}
    .ai-nav-tabs__link-{{ ai_gen_id }}.active {
      color: {{ block.settings.text_active_color }};
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-nav-tabs__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.gap | divided_by: 2 }}px;
    }

    .ai-nav-tabs__left-{{ ai_gen_id }},
    .ai-nav-tabs__right-{{ ai_gen_id }} {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }

    .ai-nav-tabs__link-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<nav-tabs-{{ ai_gen_id }} class="ai-nav-tabs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-nav-tabs__container-{{ ai_gen_id }}">
    <div class="ai-nav-tabs__left-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign link_key = 'left_link_' | append: i
          assign text_key = 'left_text_' | append: i
          assign link_url = block.settings[link_key]
          assign link_text = block.settings[text_key]
        %}
        {% if link_text != blank %}
          <a
            href="{% if link_url != blank %}{{ link_url }}{% else %}#{% endif %}"
            class="ai-nav-tabs__link-{{ ai_gen_id }}"
            data-tab-link
          >
            {{ link_text }}
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-nav-tabs__right-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign link_key = 'right_link_' | append: i
          assign text_key = 'right_text_' | append: i
          assign link_url = block.settings[link_key]
          assign link_text = block.settings[text_key]
        %}
        {% if link_text != blank %}
          <a
            href="{% if link_url != blank %}{{ link_url }}{% else %}#{% endif %}"
            class="ai-nav-tabs__link-{{ ai_gen_id }}"
            data-tab-link
          >
            {{ link_text }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</nav-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class NavTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.links = this.querySelectorAll('[data-tab-link]');
        this.currentPath = window.location.pathname;
        this.setActiveTab();
      }

      setActiveTab() {
        this.links.forEach((link) => {
          const linkPath = new URL(link.href, window.location.origin).pathname;
          
          if (linkPath === this.currentPath) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }
    }

    customElements.define('nav-tabs-{{ ai_gen_id }}', NavTabs{{ ai_gen_id }});
  })();
</script>

