{% doc %}
  @prompt
    Tabs de navegación en el header. que pueda poner textos a la izuquierda y derecha NO en el centro
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-tabs-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-header-tabs__container-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    background-color: {{ block.settings.background_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
  }

  .ai-header-tabs__group-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.tab_spacing }}px;
    align-items: center;
  }

  .ai-header-tabs__group--left-{{ ai_gen_id }} {
    justify-content: flex-start;
  }

  .ai-header-tabs__group--right-{{ ai_gen_id }} {
    justify-content: flex-end;
  }

  .ai-header-tabs__tab-{{ ai_gen_id }} {
    text-decoration: none;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    padding: {{ block.settings.tab_padding_vertical }}px {{ block.settings.tab_padding_horizontal }}px;
    border-radius: {{ block.settings.tab_border_radius }}px;
    transition: all 0.3s ease;
    white-space: nowrap;
    background-color: transparent;
    border: {{ block.settings.tab_border_width }}px solid transparent;
  }

  .ai-header-tabs__tab-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
    background-color: {{ block.settings.tab_hover_bg }};
    border-color: {{ block.settings.tab_hover_border }};
  }

  .ai-header-tabs__tab--active-{{ ai_gen_id }} {
    color: {{ block.settings.active_text_color }};
    background-color: {{ block.settings.active_bg_color }};
    border-color: {{ block.settings.active_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-header-tabs__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
    }

    .ai-header-tabs__group-{{ ai_gen_id }} {
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
    }

    .ai-header-tabs__tab-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
      padding: {{ block.settings.tab_padding_vertical | times: 0.8 }}px {{ block.settings.tab_padding_horizontal | times: 0.8 }}px;
    }
  }
{% endstyle %}

<nav-tabs-{{ ai_gen_id }} class="ai-header-tabs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-tabs__container-{{ ai_gen_id }}">
    <div class="ai-header-tabs__group-{{ ai_gen_id }} ai-header-tabs__group--left-{{ ai_gen_id }}">
      {% if block.settings.left_tab_1_text != blank %}
        <a
          href="{{ block.settings.left_tab_1_link }}"
          class="ai-header-tabs__tab-{{ ai_gen_id }}"
          data-tab-id="left-1"
        >
          {{ block.settings.left_tab_1_text }}
        </a>
      {% endif %}

      {% if block.settings.left_tab_2_text != blank %}
        <a
          href="{{ block.settings.left_tab_2_link }}"
          class="ai-header-tabs__tab-{{ ai_gen_id }}"
          data-tab-id="left-2"
        >
          {{ block.settings.left_tab_2_text }}
        </a>
      {% endif %}

      {% if block.settings.left_tab_3_text != blank %}
        <a
          href="{{ block.settings.left_tab_3_link }}"
          class="ai-header-tabs__tab-{{ ai_gen_id }}"
          data-tab-id="left-3"
        >
          {{ block.settings.left_tab_3_text }}
        </a>
      {% endif %}

      {% if block.settings.left_tab_4_text != blank %}
        <a
          href="{{ block.settings.left_tab_4_link }}"
          class="ai-header-tabs__tab-{{ ai_gen_id }}"
          data-tab-id="left-4"
        >
          {{ block.settings.left_tab_4_text }}
        </a>
      {% endif %}
    </div>

    <div class="ai-header-tabs__group-{{ ai_gen_id }} ai-header-tabs__group--right-{{ ai_gen_id }}">
      {% if block.settings.right_tab_1_text != blank %}
        <a
          href="{{ block.settings.right_tab_1_link }}"
          class="ai-header-tabs__tab-{{ ai_gen_id }}"
          data-tab-id="right-1"
        >
          {{ block.settings.right_tab_1_text }}
        </a>
      {% endif %}

      {% if block.settings.right_tab_2_text != blank %}
        <a
          href="{{ block.settings.right_tab_2_link }}"
          class="ai-header-tabs__tab-{{ ai_gen_id }}"
          data-tab-id="right-2"
        >
          {{ block.settings.right_tab_2_text }}
        </a>
      {% endif %}

      {% if block.settings.right_tab_3_text != blank %}
        <a
          href="{{ block.settings.right_tab_3_link }}"
          class="ai-header-tabs__tab-{{ ai_gen_id }}"
          data-tab-id="right-3"
        >
          {{ block.settings.right_tab_3_text }}
        </a>
      {% endif %}

      {% if block.settings.right_tab_4_text != blank %}
        <a
          href="{{ block.settings.right_tab_4_link }}"
          class="ai-header-tabs__tab-{{ ai_gen_id }}"
          data-tab-id="right-4"
        >
          {{ block.settings.right_tab_4_text }}
        </a>
      {% endif %}
    </div>
  </div>
</nav-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class NavTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-header-tabs__tab-{{ ai_gen_id }}');
        this.highlightActiveTab();
      }

      highlightActiveTab() {
        const currentPath = window.location.pathname;

        this.tabs.forEach((tab) => {
          const tabHref = tab.getAttribute('href');

          if (tabHref && currentPath === tabHref) {
            tab.classList.add('ai-header-tabs__tab--active-{{ ai_gen_id }}');
          } else {
            tab.classList.remove('ai-header-tabs__tab--active-{{ ai_gen_id }}');
          }
        });
      }
    }

    customElements.define('nav-tabs-{{ ai_gen_id }}', NavTabs{{ ai_gen_id }});
  })();
</script>

