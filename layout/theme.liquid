{% render 'help-widget' %}
<script type="module">
  import { onLCP, onINP, onCLS, onFCP, onTTFB } from 'https://unpkg.com/web-vitals@3/dist/web-vitals.js?module';

  const getDeviceContext = () => {
      const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      return {
          hw_ram: navigator.deviceMemory || 'unknown',
          hw_cpus: navigator.hardwareConcurrency || 'unknown',
          net_type: conn ? conn.effectiveType : 'unknown',
          net_speed: conn ? conn.downlink : 'unknown',
      };
  };

  const sendToGA4 = (metric) => {
      const { name, value, rating, id } = metric;

      if (name !== 'CLS' && value <= 0) return;

      // FILTRO ANTI-PESTAÑAS OCULTAS (OUTLIERS): 
      // Si FCP, LCP, TTFB o INP tardan más de 60 segundos (60000 ms), es un bug de fondo. Lo descartamos.
      if (name !== 'CLS' && value > 60000) return;

      const payload = {
          vitals_name: name,
          vitals_value: name === 'CLS' ? Math.round(value * 1000) : Math.round(value),
          vitals_rating: rating,
          vitals_id: id,
          ...getDeviceContext(),
          transport_type: 'beacon' // Forzar el envío incluso si el usuario está cerrando la pestaña
      };

    
      // Este tema carga Google Tag Manager (gtm.js), que NO define window.gtag por sí
      // solo -- solo lo hace la librería gtag.js. Llamar a gtag(...) directo acá tiraba
      // "ReferenceError: gtag is not defined" en cada pageview (detectado en auditoría
      // jul-2026), rompiendo la medición de estas métricas. Empujamos a dataLayer (la
      // API real de GTM) y, si además existe gtag.js cargado en el futuro, lo usamos también.
      const sendVitalsEvent = () => {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'web_vitals_performance', ...payload });
          if (typeof gtag === 'function') {
              gtag('event', 'web_vitals_performance', payload);
          }
      };

      if (name === 'CLS' || name === 'INP') {
          sendVitalsEvent();
      } else {
          if ('requestIdleCallback' in window) {
              requestIdleCallback(sendVitalsEvent);
          } else {
              sendVitalsEvent();
          }
      }
  };


  onFCP(sendToGA4);
  onLCP(sendToGA4);
  onTTFB(sendToGA4);
  onCLS(sendToGA4); 
  onINP(sendToGA4);
</script>
